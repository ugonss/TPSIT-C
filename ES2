#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    for (int i = 0; i < 3; i++) {
        pid_t pid = fork();

        if (pid == 0) {
            printf("[Figlio %d] Il mio PID è %d\n", i + 1, getpid());
            sleep(2);
            exit(0);   
        }
    }
    for (int i = 0; i < 3; i++) {
        wait(NULL);
    }
    printf("[Padre] Tutti i figli hanno terminat \n");

    return 0;
}
