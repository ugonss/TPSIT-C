#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>
int main() {
    pid_t pid1 = fork();

    if (pid1 == 0) {
        pid_t pid2 = fork();

        if (pid2 == 0) {
            printf("[Nipote] PID %d: termino \n", getpid());
            exit(0);
        } else {
            wait(NULL);
            printf("[Padre] PID %d: termino \n", getpid());
            exit(0);
        }
    } else {
        wait(NULL);       
        printf("[Nonno] PID %d: termino \n", getpid());
    }
    return 0;
}
